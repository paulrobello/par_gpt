{
  // markdownlint-cli2 configuration.
  // Style-opinion rules that would churn existing prose are disabled so the hook
  // enforces structure (headings, duplicate headings, required headings) without
  // reformatting wrapped text. Adjust by tightening rules incrementally.
  "config": {
    "default": true,
    // Wrapped prose: do not enforce a hard line length.
    "MD013": false,
    // Allow inline HTML (Mermaid needs none, but blockquote callouts and <br/> are used).
    "MD033": false,
    // Allow bare URLs (common in tables and reference lists).
    "MD034": false,
    // Allow consecutive callout blockquotes (Note/Tip/Warning/Security shown back-to-back).
    "MD028": false,
    // Do not require leading '#' spacing style enforcement that conflicts with existing docs.
    "MD012": { "lines": 2 }
  },
  "ignores": [
    "node_modules/**",
    ".venv/**",
    // Historical content; not maintained, do not lint.
    "docs/archive/**",
    // Auto-generated by release tooling.
    "CHANGELOG.md"
  ]
}
